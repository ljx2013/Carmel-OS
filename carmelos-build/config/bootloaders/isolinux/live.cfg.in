label live-@FLAVOUR@
        menu label ^Start CarmelOS (Live)
        menu default
        kernel @KERNEL@
        append initrd=@INITRD@ boot=live config @LB_BOOTAPPEND_LIVE@

label live-@FLAVOUR@-failsafe
        menu label Start CarmelOS (failsafe mode)
        menu default
        kernel @KERNEL@
        append initrd=@INITRD@ boot=live config @LB_BOOTAPPEND_LIVE@ @LB_BOOTAPPEND_FAILSAFE@
